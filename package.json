{
  "name": "@flotiq/api",
  "version": "1.1.2",
  "description": "Flotiq API",
  "keywords": [
    "flotiq",
    "cms",
    "headless",
    "content"
  ],
  "homepage": "https://github.com/flotiq/flotiq-api#readme",
  "bugs": {
    "url": "https://github.com/flotiq/flotiq-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/flotiq/flotiq-api.git"
  },
  "license": "MIT",
  "author": "Flotiq team <hello@flotiq.com>",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./logger": {
      "import": "./src/logger.js",
      "default": "./src/logger.js"
    },
    "./logger.js": {
      "import": "./src/logger.js",
      "default": "./src/logger.js"
    },
    "./src/logger.js": {
      "import": "./src/logger.js",
      "default": "./src/logger.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "form-data": "^4.0.5",
    "progress": "^2.0.3",
    "traverse": "^0.6.11",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
